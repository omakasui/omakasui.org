---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

interface Props {
    src: ImageMetadata
    name: string
    id: string
    priority?: boolean
}

const { src, name, id, priority = false } = Astro.props
const dialogId = `modal-${id}`
---

<button
    type="button"
    class="block w-full cursor-pointer"
    commandfor={dialogId}
    command="show-modal"
    title={`Open preview of ${name}`}
>
    <Image
        src={src}
        width={800}
        alt={`${name} preview`}
        class="h-48 w-full rounded-lg object-cover transition-transform duration-300 ease-in-out hover:scale-105"
        loading="eager"
        priority={priority}
    />
</button>

<dialog
    id={dialogId}
    closedby="any"
    aria-label={`${name} preview`}
    class="m-auto max-h-none max-w-none overflow-visible bg-transparent p-0 backdrop:bg-black/50"
>
    <button
        type="button"
        class="absolute -top-10 right-0 cursor-pointer text-2xl text-white transition-colors hover:text-gray-300"
        commandfor={dialogId}
        command="close"
        aria-label="Close preview"
    >
        <i class="nf nf-md-close"></i>
    </button>
    <Image
        src={src}
        alt={`${name} full size`}
        class="max-h-[90vh] w-auto max-w-[calc(100vw-2rem)] rounded-lg shadow-2xl"
        loading="eager"
        fetchpriority="low"
    />
</dialog>
